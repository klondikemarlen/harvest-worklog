#!/usr/bin/env bash
set -euo pipefail

installed_plugin() {
  omp plugin list --json | node -e '
    const plugins = JSON.parse(require("fs").readFileSync(0, "utf8")).npm ?? []
    process.exit(plugins.some(plugin => plugin.name === process.argv[1]) ? 0 : 1)
  ' "$1"
}

if installed_plugin omp-worklog; then
  omp plugin uninstall omp-worklog
fi

if installed_plugin harvest-worklog; then
  omp plugin uninstall harvest-worklog
fi

omp plugin install --force github:klondikemarlen/omp-worklog
